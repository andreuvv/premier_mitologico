# Copy to scripts/.env and fill in. scripts/.env is gitignored.

# BunnyCDN Storage Zone name (created in the Bunny dashboard).
BUNNY_STORAGE_ZONE=

# Storage Zone password / Storage API access key
# (Bunny dashboard -> Storage Zone -> FTP & API Access -> Password).
BUNNY_STORAGE_KEY=

# Storage endpoint host. Default region (Falkenstein/DE) = storage.bunnycdn.com.
# Other regions use a prefix, e.g. la.storage.bunnycdn.com, ny.storage.bunnycdn.com.
BUNNY_STORAGE_HOST=storage.bunnycdn.com

# Public Pull Zone host linked to the storage zone, e.g. myl-cards.b-cdn.net
BUNNY_PULLZONE_HOST=

# Optional: override the API export path used by merge-cards.mjs
# API_JSON=C:/Users/veanv/Desktop/api.mazos.cl_cartas_pb.json
