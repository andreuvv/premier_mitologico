# Copia este archivo como .env.local y completa los valores.
# Las mismas variables deben existir como secrets en GitHub (ver .github/workflows/deploy.yml).

# Supabase
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Google Maps (mapa del torneo)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-key-here
